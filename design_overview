## 8. Cargo Dependencies Reference (`Cargo.toml`)

```toml
[package]
name = "loxia"
version = "0.1.0"
edition = "2021"
authors = ["loxia contributors"]
description = "A terminal music client for Emby"

[dependencies]
# Async Runtime & Networking
tokio = { version = "1.38", features = ["full"] }
reqwest = { version = "0.12", features = ["json", "stream"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

# TUI & Terminal Graphics
ratatui = "0.26"
crossterm = "0.27"
ratatui-image = "1.0"

# Audio Backend & DSP
libmpv = "2.0"

# Cross-Platform OS Integrations
souvlaki = "0.7"     # Cross-platform media keys (MPRIS2, SMTC, CoreAudio NowPlaying)
notify-rust = "4.11" # Native OS desktop notifications
dirs = "5.0"         # Cross-platform config & data directories (~/.config, AppData, etc.)

# Utilities
fuzzy-matcher = "0.3"
toml = "0.8"
tracing = "0.1"
tracing-subscriber = "0.3"
```

