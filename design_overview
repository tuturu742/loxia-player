rolling_max_gb = 5.0
download_dir = "auto"
cache_dir = "auto"

[transcode]
mode = "direct"                   # "direct", "transcode_high" (320k), "transcode_med" (192k), "transcode_low" (96k)
target_codec = "mp3"              # "mp3", "aac", or "opus"
download_uncompressed = true      # Always download raw FLAC when pinning offline files

[ui]
theme = "cyberpunk_neon"           # "default_terminal", "far_blue", "darcula", "cyberpunk_neon", "amber_crt", "green_crt", "oled_black"
album_art_protocol = "kitty"      # "kitty", "sixel", or "off"
show_spectrum_analyzer = true
desktop_notifications = true
enable_mouse = true               # Full mouse click, seek, and trackpad scroll support
restore_session = true            # Restores queue, timestamp, and tab state on launch

[sorting]
default_queue_profile = "chronological_discog"

[[sorting.profiles]]
name = "chronological_discog"
rules = [
  { field = "album_artist", direction = "asc" },
  { field = "year", direction = "asc" },
  { field = "album", direction = "asc" },
  { field = "track_number", direction = "asc" }
]

[[sorting.profiles]]
name = "release_chronology"
rules = [
  { field = "year", direction = "desc" },
  { field = "album", direction = "asc" },
  { field = "track_number", direction = "asc" }
]

[equalizer]
enabled = true
active_preset = "darkwave_ebm"

[[equalizer.custom_presets]]
name = "night_listening_warm"
gains = [2.0, 2.0, 1.0, 0.0, 0.0, -1.0, -1.5, -2.0, -3.0, -4.0]

[keybindings]
play_pause = "Space"
next_track = "Char('n')"
prev_track = "Char('p')"
toggle_help = "Char('?')"
toggle_visual_select = "Char('v')"
open_device_picker = "Char('O')"
open_sleep_timer = "Char('T')"
download_item = "Char('d')"
cycle_quality = "Char('q')"
toggle_shuffle = "Char('s')"
open_sort_menu = "Char('o')"
queue_artist_only = "Char('a')"
queue_full_context = "Char('A')"
insert_next = "Char('i')"
instant_mix = "Char('m')"
save_queue_as_playlist = "Char('P')"
add_to_playlist = "Modifiers(CONTROL) + Char('p')"
jump_tab_now_playing = "Modifiers(ALT) + Char('1')"
jump_tab_favourites = "Modifiers(ALT) + Char('2')"
jump_tab_search = "Modifiers(ALT) + Char('3')"
jump_tab_playlists = "Modifiers(ALT) + Char('4')"
jump_tab_artists = "Modifiers(ALT) + Char('5')"
jump_tab_albums = "Modifiers(ALT) + Char('6')"
jump_tab_genres = "Modifiers(ALT) + Char('7')"
jump_tab_folders = "Modifiers(ALT) + Char('8')"
jump_tab_settings = "Modifiers(ALT) + Char('9')"
go_to_artist = "Modifiers(CONTROL) + Char('a')"
